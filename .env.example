# Copy this file to .env and add your real Gemini API key.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
# Change this if Google AI Studio recommends a different available model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional but strongly recommended for publicly deployed services.
# The exact same secret must be set on BOTH the FastAPI and Streamlit services.
APP_ACCESS_TOKEN=change_this_to_a_long_random_shared_token

# Local frontend URL. In Docker Compose use http://api:8000 instead.
API_BASE_URL=http://127.0.0.1:8000
